# Required — Google Gemini API key used by all AI routes (chat, generate, build, agent)
GEMINI_API_KEY=<redacted>

# Optional — Groq API key for Deep-mode reasoning (free, no card).
# Create one at console.groq.com (sign up, API Keys -> Create API Key)
# and paste it here / in Vercel (Production + Preview). Without it,
# Deep mode behaves exactly as before (Gemini 3.8 Flash + reasoning
# prompt). With it, Deep tries Groq's DeepSeek R1-distill reasoning
# model first (deepseek-r1-distill-llama-70b — the 70B DISTILL, not
# the full 671B R1; ~1,000 req/day free) and falls back to Gemini on
# any Groq failure, so the user never sees a Groq error outright.
GROQ_API_KEY=

# Optional — public URL of the deployment (used for metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://anvix-ai.vercel.app

# Optional — Supabase project for accounts + cloud sync.
# Without these, the app runs in guest mode (data stays in the browser).
# Setup: create a Supabase project, run supabase/schema.sql in its SQL editor,
# then copy the project URL and anon key from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<redacted>

# Optional — Web Push (VAPID). Generate once with:
#   npx web-push generate-vapid-keys
# Without these, push reports itself as unavailable in Settings.
# Run supabase/notifications.sql for the push_subscriptions table.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://anvix-ai.vercel.app

# Optional — Telegram notifications (free). Bot token from @BotFather.
# Without it, Telegram reports itself as unavailable in Settings.
# Run supabase/notifications.sql for telegram_links + link codes, then
# point the bot at https://<site>/api/telegram/webhook (see
# docs/notifications.md). TELEGRAM_BOT_USERNAME enables the one-tap
# t.me link; TELEGRAM_WEBHOOK_SECRET authenticates webhook calls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional — transactional email via Resend (free: 3,000/month, 100/day).
# Without it, email reports itself as unavailable in Settings.
# RESEND_FROM defaults to Resend's onboarding sender, which only
# delivers to the Resend account owner until a domain is verified.
RESEND_API_KEY=
RESEND_FROM=

# Optional — your-own-key (BYOK) + OpenRouter compare key encryption.
# One shared secret: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, BYOK keys and compare keys cannot be stored; the Settings
# page says so and the shared key stays the default.
BYOK_ENCRYPTION_KEY=

# Optional — Supabase service-role key (server only, NEVER public).
# Needed for share-link reads (/api/share/[token]); without it, sharing
# answers 503 "sharing unavailable". BYOK never needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — GitHub OAuth App (export / import / push to GitHub).
# Register an OAuth App in GitHub Settings -> Developer settings, set the
# callback to https://<site>/api/github/callback, then paste the ID + secret.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional — Google Calendar OAuth (connect, ask, add events).
# Create OAuth credentials in Google Cloud Console (Calendar API enabled),
# add https://<site>/api/integrations/google/callback as an authorised
# redirect URI. GOOGLE_OAUTH_REDIRECT_URI is only needed when the derived
# origin is wrong (e.g. behind a proxy); otherwise it is derived per request.
# GOOGLE_TOKEN_ENCRYPTION_KEY is 32 random bytes, base64 (same generator as
# BYOK_ENCRYPTION_KEY above, but a DIFFERENT value). See
# docs/google-calendar-setup.md. Gmail is deliberately not connected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
