# Required — Google Gemini API key used by all AI routes (chat, generate, build, agent)
GEMINI_API_KEY=

# Optional — public URL of the deployment (used for metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://anvix-ai.vercel.app

# Optional / not yet wired — PostgreSQL connection for the persistence layer in lib/db
# (reserved for the accounts + cloud-sync upgrade; the app runs without it today)
DATABASE_URL=
