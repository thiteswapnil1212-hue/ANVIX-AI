# Required — Google Gemini API key used by all AI routes (chat, generate, build, agent)
GEMINI_API_KEY=<redacted>

# Optional — public URL of the deployment (used for metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://anvix-ai.vercel.app

# Optional — Supabase project for accounts + cloud sync.
# Without these, the app runs in guest mode (data stays in the browser).
# Setup: create a Supabase project, run supabase/schema.sql in its SQL editor,
# then copy the project URL and anon key from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<redacted>
